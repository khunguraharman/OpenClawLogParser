<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.openclaw.log-parser</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/env</string>
      <string>python3</string>
      <string>openclaw_log_parser.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/openclaw-log-parser</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/openclaw-log-parser.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/openclaw-log-parser.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>OPENCLAW_POSTGRES_DSN</key>
      <string>postgresql://user:password@127.0.0.1:5432/openclaw</string>
      <key>OPENCLAW_LOG_DIRECTORY</key>
      <string>/var/log/openclaw</string>
      <key>OPENCLAW_STATE_FILE</key>
      <string>/opt/openclaw-log-parser/.openclaw_log_parser_state.json</string>
      <key>OPENCLAW_LOG_GLOB</key>
      <string>openclaw-*.log</string>
      <key>OPENCLAW_START_POSITION</key>
      <string>end</string>
      <key>OPENCLAW_POLL_INTERVAL_SECONDS</key>
      <string>5</string>
      <key>OPENCLAW_BATCH_SIZE</key>
      <string>250</string>
      <key>OPENCLAW_HEALTH_HOST</key>
      <string>127.0.0.1</string>
      <key>OPENCLAW_HEALTH_PORT</key>
      <string>8089</string>
    </dict>
  </dict>
</plist>
